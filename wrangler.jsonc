{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "anwin-engagement",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above
      "binding": "WORKER_SELF_REFERENCE",
      "service": "anwin-engagement"
    }
  ],
  // RSVP Google Form; .env.local is gitignored, so these are not available on Cloudflare otherwise
  "vars": {
    "GOOGLE_FORM_ID": "1FAIpQLSenWwfs6jF2O4QZclciTTasy0kURJxoxZng21jNsLLyH57DDQ",
    "GF_ENTRY_ATTENDING": "entry.1376976411",
    "GF_ENTRY_FIRST_NAME": "entry.1905294028",
    "GF_ENTRY_LAST_NAME": "entry.199010292",
    "GF_ENTRY_MOBILE": "entry.603539057",
    "GF_ENTRY_HEADCOUNT": "entry.134544426",
    "GF_ENTRY_SIDE": "entry.1049304567"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
